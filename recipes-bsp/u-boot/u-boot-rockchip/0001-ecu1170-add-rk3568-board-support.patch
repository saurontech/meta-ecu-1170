+	"loadfdt=load mmc ${mmcdev}:${mmcpart} ${fdt_addr} ${fdt_file}\0" \
+	"loadramdisk=load mmc ${mmcdev}:${mmcpart} ${ramdisk_addr_r} ramdisk.gz\0" \
+	"loadusbimage=load usb ${usbdev}:${usbpart} ${loadaddr} ${image}\0" \
+	"loadusbfdt=load usb ${usbdev}:${usbpart} ${fdt_addr} ${fdt_file}\0" \
+	"loadusbramdisk=load usb ${usbdev}:${usbpart} ${ramdisk_addr_r} ramdisk.gz\0" \
+	"ramrootfstype=ext2 rootwait\0" \
+    "bootenvfile=uEnv.txt\0" \
