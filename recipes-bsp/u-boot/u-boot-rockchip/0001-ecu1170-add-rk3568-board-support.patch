+static int get_resource_base_sector(struct blk_desc *dev_desc)
+{
+	disk_partition_t part;
+	int rsce_base = 0;
+
+	if (part_get_info_by_name(dev_desc, PART_MISC, &part) < 0) {
+		printf("No resource partition\n");
+		return -ENODEV;
+	} else {
+		rsce_base = part.start;
+	}
+
+	return rsce_base;
+}
+
+static int rockchip_read_resource(u8 *buf, int offset, int len)
+{
+	struct blk_desc *dev_desc;
+	int ret = 0;
+	int rsce_base;
+	int blks;
+	u8 *data = NULL;
+
+	dev_desc = rockchip_get_bootdev();
+	if (!dev_desc) {
+		printf("No dev_desc!\n");
+		return -ENODEV;
+	}
+	rsce_base = get_resource_base_sector(dev_desc);
+	
+	blks = DIV_ROUND_UP(len, dev_desc->blksz);
+	data = memalign(ARCH_DMA_MINALIGN, blks * dev_desc->blksz);
+	if (!data) {
+		ret = -ENOMEM;
+		goto err;
+	}	
+	ret = blk_dread(dev_desc, rsce_base, 1, data);
+	ret = (ret != blks) ? -EIO : len;
+
+	memcpy(buf, (u8 *)data + offset, len);
+
+err:
+	if (data)
+		free(data);
+		
+	return ret;
+}
