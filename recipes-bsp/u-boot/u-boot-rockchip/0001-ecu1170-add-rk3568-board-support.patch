+	"advrargs=setenv bootargs " \
+		"root=/dev/ram0 rw ramdisk_size=65536 initrd=${ramdisk_addr_r},64M " \
+		"rootfstype=${ramrootfstype} ${recovery_mode}\0" \
+	"advrfs=echo Advantech  Recovery System ...; " \
+		"setenv devnum ${mmcdev}; " \
