+		"run set_addr_env; " \
+		"run advrargs; " \
+		"run loadimage; " \
+		"run loadramdisk; " \
+		"if run loadfdt; then " \
+			"booti ${kernel_addr_r} - ${fdt_addr_r}; " \
+		"else " \
+			"echo advrfs load image/fdt file failed!; " \
+		"fi\0" \
+	"advbootargs=setenv bootargs " \
+		"earlycon=uart8250,mmio32,0xfe660000 swiotlb=1 console=ttyFIQ0 " \
+		"${optargs} " \
+		"root=${rootdev} rw rootwait "\
+		"rootfstype=ext4 systemd.unified_cgroup_hierarchy=0 ${recovery_mode} swiotlb=32767\0" \
+	"advusbrfs=echo Advantech Recovery System ...; " \
+		"usb start; " \
+		"setenv usbdev 0; " \
+		"setenv usbpart 1; " \
+		"setenv devtype usb; " \
+		"run set_addr_env; " \
+		"run advrargs; " \
+		"run loadusbimage; " \
+		"run loadusbramdisk; " \
+		"if run loadusbfdt; then " \
+			"booti ${kernel_addr_r} - ${fdt_addr_r}; " \
+		"else " \
+			"echo advusbrfs load image/fdt file failed!; " \
+		"fi\0" \
+	"mmcboot=echo mmc booting system ...; " \
+		"setenv devnum 1; " \
+		"setenv mmcdev 1; " \
+		"setenv mmcpart 4; " \
+		"setenv devtype mmc; " \
+		"setenv rootdev /dev/mmcblk1p5; " \
+		"run set_addr_env; " \
+   		"if run loadbootenv; then " \
+            "echo Loaded env from ${bootenvfile};" \
+            "run importbootenv;" \
+        "fi; " \
+		"run advbootargs; " \
+		"run loadimage; " \
+		"if run loadfdt; then " \
+			"booti ${kernel_addr_r} - ${fdt_addr_r}; " \
+		"else " \
+			"echo mmcboot load image/fdt file failed!; " \
+		"fi\0" \
+	"emmcboot=echo emmc booting system ...; " \
+		"setenv devnum 0; " \
+		"setenv mmcdev 0; " \
+		"setenv mmcpart 4; " \
+		"setenv devtype mmc; " \
+		"setenv rootdev /dev/mmcblk0p5; " \
+		"run set_addr_env; " \
+   		"if run loadbootenv; then " \
+            "echo Loaded env from ${bootenvfile};" \
+            "run importbootenv;" \
+        "fi; " \
+		"run advbootargs; " \
+		"run loadimage; " \
+		"if run loadfdt; then " \
+			"booti ${kernel_addr_r} - ${fdt_addr_r}; " \
+		"else " \
+			"echo emmcboot load image/fdt file failed!; " \
+		"fi\0" \
+    "get_fdt_file=" \
+		"if test $board_name = ECU1170 || test $board_name = SYS800003; then " \
+		    "if gpio input 140; then " \
+		        "if gpio input 141; then " \
+	                "setenv fdt_file " FDTFILE_DEFAULT "; " \
+	            "else " \
+					"if test $board_name = ECU1170; then " \
+						"setenv fdt_file rk3568-ecu1170-553a.dtb; " \
+	            	"else " \
+						"setenv fdt_file rk3568-sys800003-553a.dtb; " \
+	            	"fi; " \
+	            "fi; " \
+	        "else " \
+	            "if gpio input 141; then " \
+					"if test $board_name = ECU1170; then " \
+						"setenv fdt_file rk3568-ecu1170-552a.dtb; " \
+	            	"else " \
+						"setenv fdt_file rk3568-sys800003-552a.dtb; " \
+	            	"fi; " \
+	            "else " \
+	                "setenv fdt_file " FDTFILE_DEFAULT "; " \
+	            "fi; " \
+			"fi; " \
+        "else " \
+             "setenv fdt_file " FDTFILE_DEFAULT "; " \
+		"fi\0" \
+	"advboot=echo booting system ...; " \
+        "run get_fdt_file; " \
+		"run emmcboot; " \
+		"run mmcboot; " \
+		"\0"
