+&pinctrl {
+	pmic {
+		pmic_int: pmic_int {
+			rockchip,pins =
+				<0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+
+		soc_slppin_gpio: soc_slppin_gpio {
+			rockchip,pins =
+				<0 RK_PA2 RK_FUNC_GPIO &pcfg_output_low_pull_down>;
+		};
+
+		soc_slppin_slp: soc_slppin_slp {
+			rockchip,pins =
+				<0 RK_PA2 1 &pcfg_pull_up>;
+		};
+
+		soc_slppin_rst: soc_slppin_rst {
+			rockchip,pins =
+				<0 RK_PA2 2 &pcfg_pull_none>;
+		};
+	};
+
+	usb {
+		vcc5v0_otg_en: vcc5v0-otg-en {
+			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	gmac0 {
+		gmac0_reset: gmac0_reset {
+			rockchip,pins =
+				<1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+	
+	gmac1 {
+		gmac1_reset: gmac1_reset {
+			rockchip,pins =
+				<3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+
+	misc {
+		gpio_di: gpio-di {
+			rockchip,pins =
+				<1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>, /* DI0 */
+				<1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>, /* DI1 */
+				<1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>, /* DI2 */
+				<1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>, /* DI3 */
+                <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>, /* module id bit1 */
+                <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>; /* module id bit0 */
+		};
+	};
+
+	pl_leds_pinmux {
+		pl_leds_pins: pl_leds-pins {
+			rockchip,pins =
+				<4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>, /* PLED0 */
+				<0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_down>, /* PLED1 */
+				<0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_down>, /* PLED2 */
+				<0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_down>, /* PLED3 */
+				<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_down>, /* PLED4 */
+                <3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>, /* PCIE POWER */
+                <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>, /* M.2 POWER */               
+                <3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>, /* PCIE RESET */
+                <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>; /* M.2 RESET */
+		};
+	};
